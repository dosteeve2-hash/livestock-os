# Base de données — Neon Postgres
# Chaîne de connexion depuis le dashboard Neon (Connection Details).
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Authentification — Better Auth
# Générer le secret : openssl rand -base64 32
BETTER_AUTH_SECRET=votre_secret_de_32_caracteres_minimum
BETTER_AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
